    def Scope "Materials"
    {
        def Material "OmniSurface"
        {
            token outputs:mdl:displacement.connect = </root/Materials/OmniSurface/Shader.outputs:out>
            token outputs:mdl:surface.connect = </root/Materials/OmniSurface/Shader.outputs:out>
            token outputs:mdl:volume.connect = </root/Materials/OmniSurface/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniSurface.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniSurface"
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "Gallbladder"
        {
            token outputs:mdl:displacement.connect = </root/Materials/Gallbladder/Shader.outputs:out>
            token outputs:mdl:surface.connect = </root/Materials/Gallbladder/Shader.outputs:out>
            token outputs:mdl:volume.connect = </root/Materials/Gallbladder/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                float inputs:ao_to_diffuse = 0
                color3f inputs:diffuse_color_constant = (0.14999999, 0.2, 0.2)
                asset inputs:diffuse_texture = @/home/pkorzeniowsk/Projects/surgica/DefKit_Follou/Assets/LaparoCholy/Textures/Gallbladder/Albedo.png@ (
                    colorSpace = "auto"
                )
                bool inputs:flip_tangent_u = 0
                asset inputs:normalmap_texture = @/home/pkorzeniowsk/Projects/warp-surgical/warp-surgical-dev/Projects/surgica/DefKit_Follou/Assets/LaparoCholy/Textures/Gallbladder/Normal.png@ (
                    colorSpace = "raw"
                )
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "Liver"
        {
            token outputs:mdl:displacement.connect = </root/Materials/Liver/Shader.outputs:out>
            token outputs:mdl:surface.connect = </root/Materials/Liver/Shader.outputs:out>
            token outputs:mdl:volume.connect = </root/Materials/Liver/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                float inputs:albedo_add = -0.01
                float inputs:ao_to_diffuse = 0
                float inputs:bump_factor = 1
                asset inputs:diffuse_texture = @/home/pkorzeniowsk/Projects/surgica/DefKit_Follou/Assets/LaparoCholy/Textures/Liver/Albedo.png@ (
