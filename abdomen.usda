        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.07530028254159536, 0.1599810484249073, 1.044149875718997e-14)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Scope "Looks"
